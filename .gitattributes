# CAD exchange and mesh files are generated assets. Treat them as binary so
# line-ending normalisation and whitespace checks cannot alter their geometry.
*.step binary
*.stp binary
*.obj binary
*.stl binary

# MediaPipe vendorizado: os bytes precisam bater com MANIFEST.json, entao nada
# de conversao CRLF no checkout.
condor/ui/vendor/mediapipe/** binary
