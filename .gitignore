# ── Segredos — NUNCA subir ────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.secret

# ── Dados pessoais ────────────────────────────────────────────────
# O padrao e ~/.condor, mas esta regra protege quem apontar CONDOR_HOME
# para dentro do checkout.
/.condor/
/runtime/
/data/
/output/
/tmp/

# ── Logs e temporários ────────────────────────────────────────────
*.log
*.tmp
*.swp
*.bak

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
/hub/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
/cloud/node_modules/
/cloud/.next/
/cloud/.vercel/
/cloud/coverage/
/cloud/*.tsbuildinfo

# ── OS ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

